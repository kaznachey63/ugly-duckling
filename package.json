{
  "name": "ugly-duckling",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:bot": "dotenvx run -- tsx --tsconfig src/bot/tsconfig.json src/bot/src/app/core/index.ts",
    "start:parser": "dotenvx run -- tsx --tsconfig src/parser/tsconfig.json src/parser/src/core/index.ts",
    "start:sendout": "dotenvx run -- tsx --tsconfig src/sendout/tsconfig.json src/sendout/src/core/index.ts",
    "dotenv:encrypt": "dotenvx encrypt",
    "dotenv:decrypt": "dotenvx decrypt",
    "dotenv:set": "dotenvx set",
    "reload:packages": "pnpm install",
    "remove:packages": "node -e \"require('fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "prisma:generate": "dotenvx run -- prisma generate",
    "prisma:pull": "dotenvx run -- prisma db pull",
    "prisma:pull:generate": "dotenvx run -- prisma db pull && dotenvx run -- prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "docxtemplater": "^3.71.1",
    "gigachat": "^0.0.21",
    "grammy": "^1.46.0",
    "i18next": "^26.7.1",
    "i18next-fs-backend": "^2.6.10",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "node-ssh": "^13.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "prompts": "^2.4.2",
    "quickchart-js": "^4.0.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/prompts": "^2.4.9",
    "esbuild": "^0.28.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
