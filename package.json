{
  "name": "ugly-duckling",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dotenv:encrypt": "dotenvx encrypt",
    "dotenv:decrypt": "dotenvx decrypt",
    "dev:bot": "dotenvx run -- tsx --tsconfig src/bot/tsconfig.json src/bot/src/app/core/index.ts",
    "dev:parser": "dotenvx run -- tsx --tsconfig src/parser/tsconfig.json src/parser/src/core/index.ts",
    "dev:sendout": "dotenvx run -- tsx --tsconfig src/sendout/tsconfig.json src/sendout/src/core/index.ts",
    "dev:bot:watch": "dotenvx run -- tsx watch --tsconfig src/bot/tsconfig.json src/bot/src/app/core/index.ts",
    "dev:parser:watch": "dotenvx run -- tsx watch --tsconfig src/parser/tsconfig.json src/parser/src/core/index.ts",
    "dev:sendout:watch": "dotenvx run -- tsx watch --tsconfig src/sendout/tsconfig.json src/sendout/src/core/index.ts",
    "build:bot": "esbuild src/bot/src/app/core/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=src/bot/tsconfig.json --outfile=dist/bot.js",
    "build:parser": "esbuild src/parser/src/core/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=src/parser/tsconfig.json --outfile=dist/parser.js",
    "build:sendout": "esbuild src/sendout/src/core/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=src/sendout/tsconfig.json --outfile=dist/sendout.js",
    "start:bot": "dotenvx run -- node dist/bot.js",
    "start:parser": "dotenvx run -- node dist/parser.js",
    "start:sendout": "dotenvx run -- node dist/sendout.js"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "docxtemplater": "^3.71.1",
    "gigachat": "^0.0.21",
    "grammy": "^1.46.0",
    "i18next": "^26.7.1",
    "i18next-fs-backend": "^2.6.10",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "node-ssh": "^13.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "prompts": "^2.4.2",
    "quickchart-js": "^4.0.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/prompts": "^2.4.9",
    "esbuild": "^0.28.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
