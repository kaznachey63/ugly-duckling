{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@shared/*": ["../../src/shared/*"],
      "@utils": ["./src/common/utils/index"],
      "@utils/*": ["./src/common/utils/*"],
      "@common/*": ["./src/common/*"],
      "@constants": ["./src/common/constants/index"],
      "@i18n": ["./src/ui/i18n/index"],
      "@menus/*": ["./src/ui/menus/*"],
      "@src/*": ["./src/*"],
      "@modules": ["./src/app/modules/index"],
      "@state": ["./src/app/handlers/states/index"],
      "@events": ["./src/app/handlers/events/index"],
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "../../src/shared/types/**/*.d.ts"]
}