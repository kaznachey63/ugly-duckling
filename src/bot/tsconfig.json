{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "types": ["node"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../src/shared/*"],
      "@utils": ["src/common/utils/index"],
      "@utils/*": ["src/common/utils/*"],
      "@common/*": ["src/common/*"],
      "@constants": ["src/common/constants/index"],
      "@i18n": ["src/ui/i18n/index"],
      "@menus/*": ["src/ui/menus/*"],
      "@src/*": ["src/*"],
      "@modules": ["src/app/modules/index"],
      "@state": ["src/app/handlers/states/index"],
      "@events": ["src/app/handlers/events/index"],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "../../src/shared/types/**/*.d.ts",
  ]
}