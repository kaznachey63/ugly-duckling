generator client {
  provider = "prisma-client"
  output   = "../prisma"
}

datasource db {
  provider = "postgresql"
}

model chat {
  id      Int    @id @default(autoincrement())
  chat_id String @unique(map: "chat_chat_id")
  title   String
  link    String
}

model contract {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  date_start DateTime? @db.Date
  date_end   DateTime? @db.Date
  price      Int?
  price_text String?
  user       user?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contract_user_fk")
  sendout    sendout[]

  @@index([user_id], map: "fki_contracts_users_fk")
}

model credential {
  id             Int      @id @default(autoincrement())
  api_id         BigInt?  @unique(map: "credential_api_id")
  api_hash       String?  @unique(map: "credential_api_hash")
  string_session String?  @unique(map: "credential_string_session")
  sendout        sendout?
}

model media {
  id         Int      @id @default(autoincrement())
  position   Int?
  name       String?  @unique(map: "media_name")
  message_id Int?
  message    message? @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "media_message_fk")

  @@index([message_id], map: "fki_media_message_fk")
}

model message {
  id         Int      @id @default(autoincrement())
  position   Int?
  caption    String?
  entities   Json?
  sendout_id Int?
  media      media[]
  sendout    sendout? @relation(fields: [sendout_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_sendout_fk")

  @@index([sendout_id], map: "fki_message_sendout_fk")
}

model result {
  id         Int       @id @default(autoincrement())
  success    Int?
  chats      Json?
  date_time  DateTime? @db.Timestamp(6)
  sendout_id Int?
  sendout    sendout?  @relation(fields: [sendout_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "result_sendout_fk")

  @@index([sendout_id], map: "fki_result_sendout_fk")
}

model role {
  id   Int    @id @default(autoincrement())
  code String @unique(map: "role_code")
  user user[]
}

model schedule {
  id         Int      @id @default(autoincrement())
  position   Int?
  cron       String?
  label      String?
  sendout_id Int?
  sendout    sendout? @relation(fields: [sendout_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "schedule_sendout_fk")

  @@index([sendout_id], map: "fki_schedule_sendout_fk")
}

model sendout {
  id                Int         @id @default(autoincrement())
  name              String?     @unique(map: "sendout_name")
  label             String?     @unique(map: "sendout_label")
  call              String?     @unique(map: "sendout_call")
  credential_id     Int?        @unique(map: "sendout_credential_id")
  user_id           Int?
  contract_id       Int?
  telegram_topic_id Int?
  active            Boolean?
  message           message[]
  result            result[]
  schedule          schedule[]
  contract          contract?   @relation(fields: [contract_id], references: [id], onUpdate: NoAction, map: "sendout_contract_fk")
  credential        credential? @relation(fields: [credential_id], references: [id], onUpdate: NoAction, map: "sendout_credential_fk")
  user              user?       @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "sendout_user_fk")

  @@index([credential_id], map: "fki_accounts_credential_fk")
  @@index([user_id], map: "fki_accounts_users_fk")
  @@index([contract_id], map: "fki_sendouts_contracts_fk")
  @@index([credential_id], map: "fki_sendouts_credentials_fk")
  @@index([user_id], map: "fki_sendouts_users_fk")
}

model user {
  id          Int        @id @default(autoincrement())
  telegram_id BigInt?    @unique
  name        String?
  username    String?    @unique
  phone       String?    @unique
  language    String?    @default("ru")
  role_id     Int?       @default(3)
  phone_index String?
  contract    contract[]
  sendout     sendout[]
  role        role?      @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "user_role_id")

  @@index([role_id], map: "fki_users_role_fk")
  @@index([role_id], map: "fki_users_role_id")
}

model general {
  id              Int      @id(map: "general_id") @default(autoincrement())
  last_idea_id    Int?
  mode_maintenace Boolean?
  chat_test_id    Int?
  mode_test       Boolean?
}

model auth_limit {
  id              Int       @id(map: "auth_limitI_id") @default(autoincrement())
  telegram_id     BigInt?   @unique(map: "auth_limit_telegram_id")
  failed_attempts Int?      @default(0)
  blocked_until   DateTime? @db.Timestamp(6)
  last_attempt_at DateTime? @default(now()) @db.Timestamp(6)
}
